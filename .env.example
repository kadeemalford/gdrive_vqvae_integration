# Copy to .env and adjust for your local run. Do not place credentials here.
CONFIG=config/spatial_range_pilot.json
PYTHON=.venv/bin/python

RAW_DIR=data/raw
SAMPLES_DIR=data/samples
INFERENCE_RESULTS_DIR=results/inference_results
INFERENCE_CHECKPOINT=models/febus_finetune_base/best.pt
INFERENCE_DEVICE=cuda

# FEBUS fine-tuning uses one held-out configuration fold and a different validation fold.
FINETUNE_TEST_FOLD=0
FINETUNE_VAL_FOLD=1
FINETUNE_FOLDS=4
FINETUNE_EPOCHS=10
FINETUNE_LR=0.00001
FINETUNE_CHECKPOINT=models/febus_finetune_base/best.pt
FINETUNE_EARLY_STOPPING_PATIENCE=3
FINETUNE_EARLY_STOPPING_MIN_DELTA=0.0005

# Optional generalist validation and spectral objective; default loss stays unchanged.
FINETUNE_SPECTRAL_WEIGHT=0
FINETUNE_VALIDATION_DETAILS=0
FINETUNE_VAL_SAMPLES_PER_FILE=0
FINETUNE_EVALUATE_INITIAL=0
